rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserPlan() {
      return getUserData().planExpiresAt == null || getUserData().planExpiresAt > request.time ? getUserData().plan : 'free';
    }

    function isPro() {
      return getUserPlan() in ['pro', 'business'];
    }

    function isBusiness() {
      return getUserPlan() == 'business';
    }

    // Giới hạn thành viên theo plan
    function memberLimit() {
      return isBusiness() ? 9999 : isPro() ? 10 : 3;
    }

    // Kiểm tra fields hợp lệ
    function hasValidFields(required, optional) {
      return request.resource.data.keys().hasAll(required)
          && request.resource.data.keys().hasOnly(required.concat(optional));
    }

    // Kiểm tra các field nhạy cảm không bị thay đổi
    function notChanging(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Kiểm tra user có phải thành viên project không
    function isProjectMember(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return request.auth.uid == project.ownerId
          || request.auth.uid in project.memberIds;
    }

    function isProjectOwner(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId
          == request.auth.uid;
    }

    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {

      // Ai đã đăng nhập đều đọc được (để hiện tên, avatar)
      allow read: if isSignedIn();

      // Tạo profile — bắt buộc plan = 'free'
      allow create: if isOwner(userId)
        && hasValidFields(
          ['uid', 'email', 'displayName', 'createdAt', 'plan'],
          ['photoURL', 'updatedAt', 'fcmTokens', 'planExpiresAt', 'planUpdatedAt']
        )
        && request.resource.data.uid == userId
        && request.resource.data.plan == 'free'; // 🔒 Không cho tự đặt plan cao hơn

      // Cập nhật profile — KHÔNG được tự đổi plan
      allow update: if isOwner(userId)
        && notChanging(['plan', 'planExpiresAt', 'planUpdatedAt']); // 🔒 Chỉ Cloud Function mới đổi được plan

      // Chỉ chủ sở hữu mới xóa được
      allow delete: if isOwner(userId);

      // Settings riêng tư
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ========================================
    // PROJECTS COLLECTION
    // ========================================
    match /projects/{projectId} {

      // Chủ hoặc thành viên mới đọc được
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );

      // Tạo project — kiểm tra plan & giới hạn member
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && hasValidFields(
          ['title', 'description', 'ownerId', 'memberIds',
           'status', 'progress', 'dueDate', 'createdAt'],
          ['updatedAt', 'color', 'tags']
        )
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 1
        && request.resource.data.status in ['ongoing', 'completed', 'archived']
        // 🔒 Giới hạn số member theo plan (đếm project giới hạn qua Cloud Function)
        && request.resource.data.memberIds.size() <= memberLimit()
        // 🔒 Bắt buộc owner phải có trong memberIds
        && request.auth.uid in request.resource.data.memberIds;

      // Cập nhật — owner hoặc member, nhưng không thể đổi ownerId
      allow update: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.memberIds
        )
        && notChanging(['ownerId', 'createdAt']) // 🔒 Không cho đổi chủ sở hữu
        && request.resource.data.memberIds.size() <= memberLimit(); // 🔒 Vẫn kiểm tra giới hạn member

      // Chỉ chủ mới xóa được
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      // ======================================
      // TASKS SUBCOLLECTION
      // ======================================
      match /tasks/{taskId} {

        allow read: if isSignedIn() && (projectId == 'default' || isProjectMember(projectId));

        allow create: if isSignedIn()
          && (projectId == 'default' || isProjectMember(projectId))
          && hasValidFields(
            ['title', 'description', 'assigneeIds', 'creatorId',
             'completed', 'dueDate', 'dueTime', 'projectId', 'order', 'createdAt'],
            ['updatedAt', 'priority', 'tags', 'attachments']
          )
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.projectId == projectId;

        allow update: if isSignedIn() && (
          resource.data.creatorId == request.auth.uid ||        // Creator
          request.auth.uid in resource.data.assigneeIds ||     // Assignee
          (projectId != 'default' && isProjectOwner(projectId)) // Project owner
        )
          && notChanging(['creatorId', 'projectId', 'createdAt']); // 🔒 Không đổi các field quan trọng

        allow delete: if isSignedIn() && (
          resource.data.creatorId == request.auth.uid ||
          (projectId != 'default' && isProjectOwner(projectId))
        );
      }
    }

    // ========================================
    // CHATS COLLECTION (nhắn tin 1-1)
    // ========================================
    match /chats/{chatId} {

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2 // 🔒 Chỉ 2 người
        && hasValidFields(
          ['participantIds', 'lastMessage', 'lastMessageAt', 'unreadCount', 'createdAt'],
          ['updatedAt']
        );

      // Chỉ cập nhật lastMessage, unreadCount — không đổi participants
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds
        && notChanging(['participantIds', 'createdAt']); // 🔒 Không thêm/bớt người

      allow delete: if false; // 🔒 Không cho xóa chat (dùng soft delete)

      // Messages
      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        allow read: if isSignedIn()
          && request.auth.uid in chatData().participantIds;

        allow create: if isSignedIn()
          && request.auth.uid in chatData().participantIds
          && request.resource.data.senderId == request.auth.uid
          && hasValidFields(
            ['senderId', 'text', 'sentAt'],
            ['attachments', 'readBy', 'type', 'deletedAt', 'senderName', 'senderPhotoURL']
          );

        // 🔒 Chỉ được cập nhật readBy (đánh dấu đã đọc)
        allow update: if isSignedIn()
          && request.auth.uid in chatData().participantIds
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['readBy', 'deletedAt']);

        // Chỉ người gửi mới xóa được tin của mình
        allow delete: if isSignedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ========================================
    // GROUPS COLLECTION — 🔒 Chỉ Pro/Business
    // ========================================
    match /groups/{groupId} {

      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

      // 🔒 Chỉ Pro+ mới tạo được group chat
      allow create: if isSignedIn()
        && isPro()
        && request.auth.uid in request.resource.data.adminIds
        && request.auth.uid in request.resource.data.memberIds
        && hasValidFields(
          ['name', 'adminIds', 'memberIds', 'lastMessage',
           'lastMessageAt', 'unreadCount', 'createdAt'],
          ['description', 'updatedAt', 'photoURL']
        )
        // 🔒 Business không giới hạn, Pro tối đa 20 người
        && (isBusiness() || request.resource.data.memberIds.size() <= 20);

      // Chỉ admin mới cập nhật thông tin group
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.adminIds
        && notChanging(['createdAt'])
        // 🔒 Vẫn giữ giới hạn member khi update
        && (isBusiness() || request.resource.data.memberIds.size() <= 20);

      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.adminIds;

      // Group Messages
      match /messages/{messageId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        allow read: if isSignedIn()
          && request.auth.uid in groupData().memberIds;

        allow create: if isSignedIn()
          && request.auth.uid in groupData().memberIds
          && request.resource.data.senderId == request.auth.uid
          && hasValidFields(
            ['senderId', 'text', 'sentAt'],
            ['attachments', 'readBy', 'type', 'deletedAt', 'senderName', 'senderPhotoURL']
          );

        allow update: if isSignedIn()
          && request.auth.uid in groupData().memberIds
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['readBy', 'deletedAt']);

        allow delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          request.auth.uid in groupData().adminIds // Admin xóa được tin của bất kỳ ai
        );
      }
    }

    // ========================================
    // NOTIFICATIONS COLLECTION
    // ========================================
    match /notifications/{notificationId} {

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Mở quyền tạm thời (Cách 2) do chưa dùng được Cloud Function
      allow create: if isSignedIn();

      // 🔒 Chỉ được đánh dấu đã đọc, không đổi nội dung
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['isRead']);

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ========================================
    // SCHEDULES COLLECTION
    // ========================================
    match /schedules/{userId}/events/{eventId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && hasValidFields(
          ['title', 'description', 'date', 'time', 'color', 'createdAt'],
          ['taskId', 'updatedAt', 'repeat', 'reminder', 'location']
        );

      allow update: if isOwner(userId)
        && notChanging(['createdAt']);

      allow delete: if isOwner(userId);
    }

    // ========================================
    // SUBSCRIPTIONS — Lưu lịch sử thanh toán
    // ========================================
    match /subscriptions/{subscriptionId} {

      // Chỉ đọc subscription của chính mình
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // 🔒 Không cho client tạo/sửa/xóa — chỉ Cloud Function
      allow create, update, delete: if false;
    }

    // ========================================
    // 🔒 Chặn tất cả path còn lại
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
    
    // ========================================
		// CALLS COLLECTION — Video Call (WebRTC Signaling)
		// ========================================
	  match /calls/{callId} {
    	
      allow read:if isSignedIn()
      	&&(
        resource.data.callerUid == request.auth.uid || 
        resource.data.calleeUid == request.auth.uid
        );
    	allow create: if isSignedIn()
      	&& request.resource.data.callerUid == request.auth.uid && hasValidFields(
        ['callerUid','calleeUid', 'status', 'createdAt','type'],
        ['offer', 'answer', 'endedAt']
        )
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['video','audio'];
      allow update: if isSignedIn()
      	&& (
        
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
        )
        && notChanging (['callerUid', 'calleeUid', 'createdAt','type'])
        && request.resource.data.status in ['ringing', 'accepted','ended', 'rejected', 'missed'];
        
      allow delete: if false;
      match /callerCandidates/{candidateId} {
      	
        allow read: if isSignedIn()
        	&& (
          	get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
            get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid         
          );
        allow create: if isSignedIn()
        && get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid;
        
        allow delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if isSignedIn()
          && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
            get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
          );

        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid;

        allow update: if false
          	&& get (/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid;
        allow delete: if false;
      } 
    }

    // ========================================
    // COLLECTION GROUP RULES (Tasks across all projects)
    // ========================================
    match /{path=**}/tasks/{taskId} {
      // Cho phép đọc nếu user là người tạo hoặc người được giao
      allow read: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid in resource.data.assigneeIds
      );
      
      // Chặn mọi hành động ghi trực tiếp qua collection group
      allow write: if false;
    }
  }
}
